# Local development configuration — copy to .env and fill in real values.
# The dashboard works fully WITHOUT an OpenAI key (local analytics mode).

# --- AI (optional) -----------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MO…mini
OPENAI_TIMEOUT=30
OPENAI_MAX_CONTEXT_CHARS=6000

# --- Server -------------------------------------------------------------------
DASH_HOST=127.0.0.1
DASH_PORT=8050
DASH_DEBUG=false

# --- Upload / performance limits ----------------------------------------------
MAX_UPLOAD_MB=15
MAX_ROWS=200000
MAX_COLUMNS=200
SESSION_STORE_CAPACITY=64
